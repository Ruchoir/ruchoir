# Ruchoir environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# Every value here is a placeholder: no real secret must ever land in this file.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
# Address the Rust API binds to inside its container / on the host.
# The API loads this file on `cargo run` (real env vars still win). Set RUCHOIR_API_PORT=0 to bind
# a random free port (handy when 8080 is taken); the actual port is printed at startup.
RUCHOIR_API_HOST=0.0.0.0
RUCHOIR_API_PORT=8080
# Host port the Docker stack publishes the API on (change if 8080 is taken locally).
RUCHOIR_HOST_PORT=8080
# Directory holding the static web bundle the API serves (Next.js export output). This is the path
# on YOUR machine, because the API reads this file when you run it with `cargo run`. The Docker
# stack sets its own container path in `docker-compose.yml` and ignores this value, so leave it
# pointing at the build output: a container path here makes the host run serve nothing but 404s.
RUCHOIR_WEB_DIST=./apps/web/out
# Optional: directory holding the self-hosted emoji pack (Fluent assets), served under /emoji.
# Leave unset to omit the pack; the web client then falls back to native OS emoji. Kept out of
# the web bundle because the pack can be large. Expected layout: <dir>/static/*.svg, <dir>/animated/*.png
# RUCHOIR_EMOJI_DIR=/srv/ruchoir/emoji
# Log filter (tracing EnvFilter syntax), e.g. "info", "ruchoir_api=debug,info".
RUST_LOG=info

# ---------------------------------------------------------------------------
# Dev TLS (optional). Leave empty to serve plain HTTP in local dev.
# Generate a self-signed pair with `scripts/dev-tls.sh` (see docs).
# ---------------------------------------------------------------------------
RUCHOIR_TLS_CERT=
RUCHOIR_TLS_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL (source of truth)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ruchoir
POSTGRES_USER=ruchoir
# Choose a strong value locally; never reuse across environments.
POSTGRES_PASSWORD=change-me-in-local-env
# Connection URL used ONLY when running the API on the HOST (cargo run). The containerized API
# (docker compose) builds its own URL against the in-network `postgres` hostname, so this value
# just has to be reachable from your machine: localhost + the published host port. The password
# must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://ruchoir:change-me-in-local-env@localhost:5432/ruchoir
# Host port the Docker stack publishes PostgreSQL on (for host-side cargo run). Change if taken.
POSTGRES_HOST_PORT=5432
# Maximum size of the API's PostgreSQL connection pool.
RUCHOIR_DB_MAX_CONNECTIONS=10
# Apply pending migrations automatically on API startup. Keep true in dev; set false in
# production and run migrations explicitly with `ruchoir-api migrate` before deploying.
RUCHOIR_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Valkey (sessions, pub/sub, presence, cache). Speaks the Redis protocol (RESP).
# ---------------------------------------------------------------------------
VALKEY_HOST=valkey
VALKEY_PORT=6379
# Connection URL for the API on the HOST (cargo run); the containerized API uses the `valkey`
# hostname instead. Use localhost + the published host port here.
VALKEY_URL=redis://localhost:6379
# Host port the Docker stack publishes Valkey on (for host-side cargo run). Change if taken.
VALKEY_HOST_PORT=6379
# Size of the API's Valkey connection pool.
RUCHOIR_VALKEY_POOL_SIZE=6

# ---------------------------------------------------------------------------
# Auth (password hashing + sessions)
# ---------------------------------------------------------------------------
# argon2id cost parameters (OWASP-aligned baseline: 19 MiB, t=2, p=1). Raise on stronger hardware.
RUCHOIR_ARGON2_MEMORY_KIB=19456
RUCHOIR_ARGON2_ITERATIONS=2
RUCHOIR_ARGON2_PARALLELISM=1
# Path to the offline breached-password bloom filter (built at deploy time from a public breach
# corpus). Leave empty to disable the check. The lookup is fully local: no network request.
RUCHOIR_BREACHED_PW_BLOOM=
# Session lifetimes in seconds: sliding idle timeout (14 days) and absolute cap (30 days).
RUCHOIR_SESSION_IDLE_TTL_SECS=1209600
RUCHOIR_SESSION_ABSOLUTE_TTL_SECS=2592000
# Anti-bruteforce: lock an account after this many failed logins within the rolling window,
# then apply a progressive (doubling) cooldown from the base up to the max.
RUCHOIR_LOGIN_MAX_FAILURES=5
RUCHOIR_LOGIN_FAILURE_WINDOW_SECS=900
RUCHOIR_LOGIN_LOCK_BASE_SECS=900
RUCHOIR_LOGIN_LOCK_MAX_SECS=86400
# Coarse per-IP rate limit on the auth routes: burst capacity and the replenish interval (ms).
# Defaults allow bursts of 20 with one request replenished every 500 ms (about 2 req/s sustained).
RUCHOIR_AUTH_RATE_BURST=20
RUCHOIR_AUTH_RATE_PERIOD_MS=500

# ---------------------------------------------------------------------------
# Email (verification + password reset). Leave RUCHOIR_SMTP_HOST empty in local dev: the API then
# logs messages instead of sending them. Production MUST set a sovereign (EU / self-hosted) relay.
# ---------------------------------------------------------------------------
RUCHOIR_SMTP_HOST=
RUCHOIR_SMTP_PORT=587
RUCHOIR_SMTP_USERNAME=
RUCHOIR_SMTP_PASSWORD=
RUCHOIR_SMTP_FROM=Ruchoir <no-reply@localhost>
# Public base URL used to build verification / reset links in emails.
RUCHOIR_PUBLIC_BASE_URL=http://localhost:8080
# Token lifetimes in seconds: email verification (24 h) and password reset (1 h).
RUCHOIR_EMAIL_VERIFICATION_TTL_SECS=86400
RUCHOIR_PASSWORD_RESET_TTL_SECS=3600
# 256-bit data-encryption key (64 hex chars) for secrets at rest (MFA/TOTP). Generate with
# `openssl rand -hex 32`. REQUIRED in production; if unset, an insecure built-in dev key is used.
RUCHOIR_SECRET_ENCRYPTION_KEY=
# WebAuthn / passkeys relying party. RP id is the registrable domain (no scheme/port); origin is
# the full URL the browser sees. Defaults suit local dev; set both to your real domain in prod.
RUCHOIR_WEBAUTHN_RP_ID=localhost
RUCHOIR_WEBAUTHN_ORIGIN=http://localhost:8080
# Optional OIDC connectors, off by default. The authorization-code flow is not implemented yet;
# these only toggle the scaffold. Enable per deployment once the flow lands.
RUCHOIR_OIDC_GOOGLE_ENABLED=false
RUCHOIR_OIDC_MICROSOFT_ENABLED=false

# ---------------------------------------------------------------------------
# Real-time messaging (WebSocket / SSE transport, presence and typing).
# ---------------------------------------------------------------------------
# Live presence is a Valkey heartbeat: a connection refreshes it every
# RUCHOIR_PRESENCE_HEARTBEAT_SECS against a RUCHOIR_PRESENCE_TTL_SECS expiry, so a single missed
# beat never flips a user offline. Typing signals are throttled to at most one per conversation
# every RUCHOIR_TYPING_MIN_INTERVAL_MS. Each connection buffers up to RUCHOIR_REALTIME_SEND_BUFFER
# pending events before shedding the oldest (the client then resyncs over REST).
RUCHOIR_PRESENCE_TTL_SECS=45
RUCHOIR_PRESENCE_HEARTBEAT_SECS=20
RUCHOIR_TYPING_MIN_INTERVAL_MS=2000
RUCHOIR_REALTIME_SEND_BUFFER=256

# ---------------------------------------------------------------------------
# Garage (S3-compatible object storage). Accessed through the S3 abstraction.
# ---------------------------------------------------------------------------
# The endpoint as seen from YOUR machine, because the API reads this file when you run it with
# `cargo run`. The Docker stack sets its own `S3_ENDPOINT: http://garage:3900` in the service and
# ignores this value, so leave it on the published port: the container hostname here resolves to
# nothing on the host, and every upload fails with a 502 after a retry.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=ruchoir
# Issued by Garage after bucket/key setup; keep out of version control. When either is empty the API
# still serves file metadata and returns 503 for file bytes (upload/download/preview/thumbnail).
S3_ACCESS_KEY_ID=change-me-in-local-env
S3_SECRET_ACCESS_KEY=change-me-in-local-env
# Maximum accepted upload size, in bytes (default 100 MiB), and the longest edge of a generated
# image thumbnail, in pixels (aspect ratio preserved).
RUCHOIR_UPLOAD_MAX_BYTES=104857600
RUCHOIR_THUMBNAIL_MAX_PX=512
# Garage node secrets (NOT stored in the repo). Generate each with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-openssl-rand-hex-32
GARAGE_ADMIN_TOKEN=change-me-openssl-rand-hex-32
