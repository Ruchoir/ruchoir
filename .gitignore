# Local and private files that must never reach the public repo.
/CLAUDE.md
/CAHIER-DES-CHARGES.md
/.claude/
# Internal planning specs (kept local, alongside the product spec).
/docs/specs/

# Local development assets: import fixtures, work exports, seed stacks, design handoff.
# (The handoff directory keeps its original on-disk name; do not rename this pattern.)
/fixtures/
/workchat-design-system/

# Secrets and environment.
.env
.env.*
!.env.example

# Dependencies and build output (filled in as the stack lands).
/node_modules/
/target/
/.next/
/dist/
/apps/web/out/
# Python bytecode (the import tooling ships scripts, not a package).
__pycache__/
*.pyc

# TypeScript incremental build cache.
*.tsbuildinfo
# Generated self-hosted emoji pack (built from the Fluent Emoji repos by scripts/prepare-emoji.mjs).
/apps/web/public/emoji/

# Local dev TLS material (generated by scripts/dev-tls.sh).
/certs/
