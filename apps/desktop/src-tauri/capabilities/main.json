{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may call. The interface is served on the app's own protocol, which Tauri treats as a local origin.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "opener:allow-open-url",
    "allow-allow-frame-origin",
    "allow-instance-state",
    "allow-instance-add",
    "allow-sign-in-start",
    "allow-sign-in-cancel",
    "allow-instances-state",
    "allow-instance-open",
    "allow-instance-remove",
    "allow-instance-sign-out",
    "allow-summaries",
    "allow-preferences-changed",
    "allow-desktop-settings",
    "allow-set-desktop-settings",
    "allow-set-shell-labels",
    "allow-app-quit",
    "allow-socket-send",
    "allow-socket-is-open",
    "allow-download-save",
    "allow-file-window",
    "allow-file-open-local",
    "allow-file-dismiss",
    "allow-file-send-version",
    "allow-file-keep-copy",
    "allow-download-open",
    "allow-about-app",
    "allow-diagnostics",
    "allow-open-log-folder",
    "allow-update-state",
    "allow-update-install"
  ]
}
