{
  "name": "@ruchoir/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Ruchoir for iOS and Android, built with Expo.",
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test 'test/**/*.test.ts'",
    "i18n:check": "node ../web/tools/i18n-audit/run.mjs --app mobile",
    "bundle:ios": "EXPO_NO_TELEMETRY=1 expo export --platform ios --output-dir dist-check"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@ruchoir/client": "workspace:*",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "lucide-react-native": "~1.55.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "react-dom": "19.2.3",
    "typescript": "^6.0.3"
  }
