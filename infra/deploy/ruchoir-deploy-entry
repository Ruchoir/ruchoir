#!/bin/sh
#
# The forced command of the `deploy` account's SSH keys: whatever the client asks to run, this runs
# instead, with the requested words as the version to deploy and the connection's input as the
# bundle. It can start ruchoir-deploy and nothing else (sudoers allows exactly that).
#
# The words are a version (`v1.2.3`: the community image), or `enterprise` and a version (the
# enterprise image, built from its own repository; ADR 0010).
#
# authorized_keys:
#   command="/usr/local/sbin/ruchoir-deploy-entry",restrict ssh-ed25519 AAAA... ci-deploy
# /etc/sudoers.d/ruchoir-deploy:
#   deploy ALL=(root) NOPASSWD: /usr/local/sbin/ruchoir-deploy
set -eu
request="${SSH_ORIGINAL_COMMAND:-}"
edition=community
case "$request" in
  "enterprise "*) edition=enterprise; request="${request#enterprise }" ;;
esac
case "$request" in
  *[!A-Za-z0-9.-]*|"") echo "expected a version, such as v1.2.3, or enterprise v1.2.3" >&2; exit 2 ;;
esac
exec sudo -n /usr/local/sbin/ruchoir-deploy "$request" "$edition"
