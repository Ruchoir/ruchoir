# /etc/ruchoir-hardening/hardening.env: this server's values for the hardening scripts.
# Root, 0600. Never committed: the repository holds only this example, with placeholders.

# app (serves the Ruchoir instance) or site (website, image registry, push relay).
RUCHOIR_HARDENING_ROLE=app

# The other server, which this one watches and which watches this one.
HARDENING_PEER_HOST=peer.example.org
HARDENING_PEER_IP=203.0.113.20
# Its public names, space-separated (probed, certificates checked).
HARDENING_PEER_NAMES="www.example.org registry.example.org"
# This server's own public names.
HARDENING_PUBLIC_NAMES="app.example.org office.app.example.org"
# The house's public address: allowlisted, and SSH logins from it raise no alert.
HARDENING_HOUSE_IP=198.51.100.7

# Alerts: push through ntfy, and mail. One recipient.
NOTIFY_NTFY_URL=https://ntfy.example.org
NOTIFY_NTFY_TOPIC=app-alerts
NOTIFY_NTFY_TOKEN=tk_replace_me
NOTIFY_MAIL_TO=someone@example.org
NOTIFY_MAIL_FROM="Ruchoir alerts <alerts@example.org>"
NOTIFY_SMTP_HOST=smtp.example.org
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=replace_me
NOTIFY_SMTP_PASSWORD=replace_me
